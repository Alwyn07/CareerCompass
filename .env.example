# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/career_guidance

# Optional: If using MongoDB Atlas
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/career_guidance

# CORS - set to your frontend origin
FRONTEND_URL=http://localhost:3000

# Rate limiting (requests per 15 min per IP)
RATE_LIMIT_MAX=100
